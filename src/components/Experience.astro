---
import history from "../data/history.json";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/history/*.*",
  { eager: true }
);

function getHistoryImage(imageSrc: string): string {
  const key = `../assets/${imageSrc}`;
  return images[key]?.default.src ?? `/${imageSrc}`;
}
---

<section class="py-20 bg-white dark:bg-[#0d1117]" id="experience">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-3xl font-bold mb-16 text-center">Trayectoria Profesional</h2>
    <div class="space-y-12">
      {
        history.map((item, i) => (
          <div class="relative pl-8 md:pl-0">
            <div class="md:flex gap-12 items-start">
              <div class="md:w-1/3 md:text-right mb-4 md:mb-0">
                <p class={`font-mono font-bold ${i === 0 ? "text-primary" : "text-slate-400"}`}>
                  {`${item.startDate} — ${item.endDate}`}
                </p>
                <p class="text-slate-500 text-sm">{item.role}</p>
                {item.location && (
                  <p class="text-slate-600 text-xs mt-1">{item.location}</p>
                )}
              </div>
              <div class="md:w-2/3 relative">
                <div
                  class={`hidden md:block absolute -left-[44px] top-1.5 w-4 h-4 rounded-full border-4 border-white dark:border-[#0d1117] z-10 ${
                    i === 0 ? "bg-primary" : "bg-slate-300 dark:bg-slate-700"
                  }`}
                />
                <div class="flex items-center gap-3 mb-3">
                  <img
                    src={getHistoryImage(item.imageSrc)}
                    alt={`${item.organisation} Logo`}
                    class="w-8 h-8 rounded-lg object-contain bg-white p-1"
                  />
                  <div>
                    <h3 class="text-xl font-bold">{item.organisation}</h3>
                    {item.client && (
                      <p class="text-xs text-slate-500 font-mono">at {item.client}</p>
                    )}
                  </div>
                </div>
                <ul class="space-y-3 text-slate-600 dark:text-slate-400 text-sm list-disc pl-4">
                  {item.experiences.map((exp) => (
                    <li>{exp}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
