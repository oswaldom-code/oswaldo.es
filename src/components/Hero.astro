<section class="relative overflow-hidden py-20 lg:py-32 border-b border-slate-200 dark:border-border-dark">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full pointer-events-none opacity-20">
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary rounded-full blur-[120px]"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[30%] h-[30%] bg-blue-600 rounded-full blur-[100px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <div class="flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-mono mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
        </span>
        Disponible para nuevos proyectos
      </div>

      <h1 class="text-4xl md:text-7xl font-black tracking-tight mb-6 max-w-4xl leading-tight">
        Construyendo el <span class="text-primary">motor</span> de las aplicaciones modernas.
      </h1>

      <p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mb-10 leading-relaxed">
        Hola, soy un <span class="text-slate-900 dark:text-white font-semibold">Senior Backend Developer</span>.
        Especialista en sistemas de alto rendimiento, arquitectura distribuida y resiliencia en la nube.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          class="flex items-center gap-2 bg-primary text-white px-8 py-4 rounded-xl font-bold hover:scale-[1.02] active:scale-[0.98] transition-all"
          href="/#contact"
        >
          <span class="material-symbols-outlined text-[20px]">mail</span>
          Contactar
        </a>
        <div class="flex items-center gap-3">
          <a
            class="p-4 rounded-xl bg-slate-100 dark:bg-card-dark border border-slate-200 dark:border-border-dark hover:border-primary transition-colors group"
            href="https://github.com/oswaldom-code"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
