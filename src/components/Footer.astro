---
const currentYear = new Date().getFullYear();
---

<footer class="py-12 border-t border-slate-200 dark:border-border-dark bg-slate-50 dark:bg-[#0d1117]">
  <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-primary">terminal</span>
      <span class="font-mono text-sm opacity-50">&copy; {currentYear} Oswaldo Montaño</span>
    </div>
    <div class="flex gap-8 text-sm text-slate-500">
      <a class="hover:text-primary transition-colors" href="https://twitter.com/oswaldom_code" target="_blank" rel="noopener noreferrer">Twitter</a>
      <a class="hover:text-primary transition-colors" href="https://linkedin.com/in/oswaldomontanodev" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="hover:text-primary transition-colors" href="https://github.com/oswaldom-code" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="hover:text-primary transition-colors" href="/blog">Blog</a>
    </div>
  </div>
</footer>
