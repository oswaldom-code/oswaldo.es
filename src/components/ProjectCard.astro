---
interface Props {
  title: string;
  imageSrc: string;
  description: string;
  skills: string[];
  demo?: string;
  source?: string;
}

const { title, imageSrc, description, skills, demo, source } = Astro.props;
---

<div class="group bg-white dark:bg-card-dark border border-slate-200 dark:border-border-dark rounded-2xl overflow-hidden hover:shadow-2xl hover:shadow-primary/5 transition-all">
  <div class="h-48 bg-slate-200 dark:bg-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-transparent"></div>
    <img
      src={imageSrc}
      alt={`Image of ${title}`}
      class="w-full h-full object-cover opacity-50"
    />
  </div>
  <div class="p-8">
    <div class="flex gap-2 mb-4 flex-wrap">
      {
        skills.map((skill, i) => (
          <span
            class={`px-2 py-1 rounded text-[10px] font-mono font-bold uppercase tracking-widest ${
              i === 0
                ? "bg-primary/10 text-primary"
                : "bg-slate-100 dark:bg-slate-800 text-slate-400"
            }`}
          >
            {skill}
          </span>
        ))
      }
    </div>
    <h3 class="text-xl font-bold mb-3 group-hover:text-primary transition-colors">{title}</h3>
    <p class="text-slate-500 dark:text-slate-400 mb-6 text-sm leading-relaxed">{description}</p>
    <div class="flex items-center gap-4">
      {demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
          class="material-symbols-outlined text-slate-400 hover:text-primary transition-colors"
        >link</a>
      )}
      {source && (
        <a
          href={source}
          target="_blank"
          rel="noopener noreferrer"
          class="material-symbols-outlined text-slate-400 hover:text-primary transition-colors"
        >code</a>
      )}
    </div>
  </div>
</div>
