---
import skills from "../data/skills.json";
---

<section class="py-20 border-y border-slate-200 dark:border-border-dark" id="tech">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold mb-4">Tech Stack</h2>
      <p class="text-slate-500">Herramientas y tecnologías que domino para crear soluciones backend robustas.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
      {
        skills.map((skill) => (
          <div class="group flex flex-col items-center p-6 rounded-2xl bg-white dark:bg-card-dark border border-slate-200 dark:border-border-dark hover:border-primary transition-all">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-primary/10 mb-4 group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-primary">{skill.icon}</span>
            </div>
            <span class="font-mono text-sm font-semibold">{skill.title}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
